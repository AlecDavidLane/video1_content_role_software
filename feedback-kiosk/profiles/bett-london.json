{
  "event": {
    "id": "bett-london-2026",
    "name": "Feedback Graffiti Art",
    "subtitle": "How do you rate Transition Layer?",
    "venue": "Bett, ExCeL London"
  },
  "locale": "en-GB",
  "branding": {
    "logo": "/transition-layer-logo.png",
